+
+void ADIOI_DAOS_WriteStrided(ADIO_File fd, const void *buf, int count,
+                             MPI_Datatype datatype, int file_ptr_type,
+                             ADIO_Offset offset, ADIO_Status * status, int *error_code)
+{
